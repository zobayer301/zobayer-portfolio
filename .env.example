# Vercel Environment Variables (set these in the Vercel project dashboard)
# Dashboard > Settings > Environment Variables

# Gmail account that sends emails (your address)
GMAIL_USER=mdzobayerchowdhury3077@gmail.com

# Gmail App Password (NOT your normal password). Create at:
# Google Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=your-16-char-app-password

# Secret used to sign confirmation tokens (use a long random string in production)
VERIFY_SECRET=change-me-to-a-long-random-string

# Public site URL (used to build the confirmation link)
SITE_URL=https://zobayer-xo.vercel.app
